<section class="hero wrap">
  <div class="hero-text">
    <p class="kicker">Émulateur Game Boy et Game Boy Color</p>
    <h1>gbe</h1>
    <p class="lead">Un émulateur Game Boy et Game Boy Color écrit en Go pur, sans cgo. Image, son, sauvegardes : il suffit d'une ROM <code>.gb</code> ou <code>.gbc</code>, même compressée en <code>.zip</code>, pour jouer, sous macOS, Linux ou Windows.</p>
    <div class="actions">
      <a class="btn btn-primary" href="#telecharger">Télécharger{{with .Latest}} {{.TagName}}{{end}}</a>
      <a target="_blank" rel="noopener" class="btn" href="https://github.com/{{.Repo}}">Code source</a>
    </div>
  </div>
  <div class="consoles" data-carousel aria-roledescription="carrousel" aria-label="Les deux consoles émulées">
    <figure class="console" aria-label="Écran titre d'un jeu Game Boy affiché par gbe">
      <div class="bezel">
        <span class="led" aria-hidden="true"></span>
        <img class="screen pixelated" src="img/gb/screenshot.webp" width="640" height="576" alt="Écran titre de Super Mario Land avec la palette DMG verte">
      </div>
      <figcaption>GAME BOY · 4 TEINTES</figcaption>
    </figure>
    <figure class="console console-color" aria-label="Écran titre d'un jeu Game Boy Color affiché par gbe">
      <div class="bezel">
        <span class="led" aria-hidden="true"></span>
        <img class="screen pixelated" src="img/gbc/screenshot.webp" width="640" height="576" alt="Écran titre de Zelda: Link's Awakening DX en couleurs">
      </div>
      <figcaption>GAME BOY COLOR · 32 768 COULEURS</figcaption>
    </figure>
    <div class="carousel-nav" hidden>
      <button type="button" class="carousel-arrow" data-step="-1" aria-label="Console précédente"></button>
      <button type="button" class="carousel-dot" aria-label="Game Boy"></button>
      <button type="button" class="carousel-dot" aria-label="Game Boy Color"></button>
