<script>
  // Small screens: the menu folds behind the Menu button. Without JavaScript
  // it stays unfolded, on several lines.
  (function () {
    var bar = document.querySelector(".topbar");
    var button = bar.querySelector(".menu-toggle");
    function open(on) {
      bar.classList.toggle("is-open", on);
      button.setAttribute("aria-expanded", on ? "true" : "false");
    }
    bar.classList.add("has-menu");
    button.hidden = false;
    button.addEventListener("click", function () { open(!bar.classList.contains("is-open")); });
    bar.querySelectorAll("nav a").forEach(function (a) {
      a.addEventListener("click", function () { open(false); });
    });
    document.addEventListener("click", function (e) {
      if (!bar.contains(e.target)) open(false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && bar.classList.contains("is-open")) {
        open(false);
        button.focus();
      }
    });
  })();

  // Highlight the visitor's platform in the download section.
  (function () {
    var ua = navigator.userAgent;
    var os = /Mac/.test(ua) ? "macos" : /Win/.test(ua) ? "windows" : /Linux/.test(ua) ? "linux" : "";
    var card = os && document.querySelector('.download[data-os="' + os + '"]');
    if (card) card.classList.add("current");
  })();

  // Hero carousel: one console at a time. Without JavaScript both stay side
  // by side. The active dot fills up in 5 s, and the end of that animation
  // shows the next console; hovering or focusing the carousel pauses it, and
  // any action starts the 5 s over.
  (function () {
    var root = document.querySelector("[data-carousel]");
    if (!root) return;
    var slides = root.querySelectorAll(".console");
    var dots = root.querySelectorAll(".carousel-dot");
    var nav = root.querySelector(".carousel-nav");
    var current = 0;

    function show(index, step) {
      var next = (index + slides.length) % slides.length;
      if (next !== current) {
        var incoming = slides[next];
        // Start the incoming console on the side it comes from, then let
        // the transition bring it in while the current one leaves.
        incoming.classList.remove("to-left", "to-right");
        incoming.classList.add(step > 0 ? "from-right" : "from-left");
        void incoming.offsetWidth;
        incoming.classList.remove("from-right", "from-left");
        slides[current].classList.add(step > 0 ? "to-left" : "to-right");
      }
      slides.forEach(function (s, i) {
        var active = i === next;
        s.classList.toggle("is-active", active);
        s.setAttribute("aria-hidden", active ? "false" : "true");
        s.inert = !active;
      });
      current = next;
      dots.forEach(function (d, i) {
        d.classList.remove("is-active");
        d.setAttribute("aria-current", i === next ? "true" : "false");
      });
      void dots[next].offsetWidth; // restart the 5 s fill
      dots[next].classList.add("is-active");
    }

    root.classList.add("is-carousel");
    nav.hidden = false;
    show(0, 1);

    dots.forEach(function (d, i) {
      d.addEventListener("click", function () { show(i, i > current ? 1 : -1); });
      d.addEventListener("animationend", function () { show(current + 1, 1); });
    });
    root.querySelectorAll(".carousel-arrow").forEach(function (b) {
      b.addEventListener("click", function () {
        var step = Number(b.dataset.step);
        show(current + step, step);
      });
    });
    root.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") show(current - 1, -1);
      else if (e.key === "ArrowRight") show(current + 1, 1);
    });

    // Swipe on touch screens.
    var startX = null;
    root.addEventListener("pointerdown", function (e) { startX = e.clientX; });
    root.addEventListener("pointerup", function (e) {
      if (startX === null) return;
      var dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });

    function pause(on) { root.classList.toggle("is-paused", on); }
    root.addEventListener("mouseenter", function () { pause(true); });
    root.addEventListener("mouseleave", function () { pause(root.contains(document.activeElement)); });
    root.addEventListener("focusin", function () { pause(true); });
    root.addEventListener("focusout", function (e) {
      if (!root.contains(e.relatedTarget)) pause(root.matches(":hover"));
    });
  })();
</script>
</body>
