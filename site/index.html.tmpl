      <figure{{if $i}} aria-hidden="true"{{end}}><img src="img/gbc/save_state_resume.webp" width="1280" height="1152" loading="lazy" alt="Au lancement de Zelda: Link's Awakening DX, gbe propose de reprendre la partie sauvegardée"><figcaption>Les save states, en couleurs aussi</figcaption></figure>
